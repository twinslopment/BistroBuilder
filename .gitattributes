# Auto detect text files and perform LF normalization
* text=auto

# Unity/YAML/editor text assets: keep a single canonical EOL on every platform.
*.meta text eol=lf
*.asset text eol=lf
*.prefab text eol=lf
*.unity text eol=lf
*.cs text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.svg text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.json text eol=lf
*.md text eol=lf


# SAVIC immutable source archive: large binary sources are versioned through Git LFS.
/ContentSource/**/*.glb filter=lfs diff=lfs merge=lfs -text
/ContentSource/**/*.gltf filter=lfs diff=lfs merge=lfs -text
/ContentSource/**/*.fbx filter=lfs diff=lfs merge=lfs -text
/ContentSource/**/*.obj filter=lfs diff=lfs merge=lfs -text
/ContentSource/**/*.png filter=lfs diff=lfs merge=lfs -text
/ContentSource/**/*.jpg filter=lfs diff=lfs merge=lfs -text
/ContentSource/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
/ContentSource/**/*.webp filter=lfs diff=lfs merge=lfs -text
/ContentSource/**/*.tga filter=lfs diff=lfs merge=lfs -text
/ContentSource/**/*.psd filter=lfs diff=lfs merge=lfs -text
